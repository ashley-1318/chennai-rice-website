# Environment variables (contains API keys — never commit)
.env
.env.local
.env.*.local
server/.env
# Broad safety net for any other real env file, but NOT *.example files —
# those are meant to be committed (see server/.env.example,
# .env.local.example) so contributors know which vars to set.
.env*
!.env*.example

# Vercel CLI project link metadata
.vercel

# Local dev proxy dependencies (server/) — reinstall with `npm install`
server/node_modules

# Root dependencies and build output — reinstall/rebuild instead of tracking
node_modules
dist
